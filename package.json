{
  "name": "es-modbus",
  "version": "0.3.2",
  "description": "Modbus TCP, RTU, RTU-over-TCP, UDP and RTU-over-UDP client and server for Node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goosy/es_modbus.git"
  },
  "homepage": "https://github.com/goosy/es_modbus#readme",
  "bugs": "https://github.com/goosy/es_modbus/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/modbus.d.ts",
      "default": "./dist/modbus.js"
    }
  },
  "files": [
    "dist",
    "native",
    "THIRD_PARTY_LICENSES",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "rolldown": "^1.3.2",
    "serialport-rs": "0.7.3",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "node build.js",
    "test": "pnpm build && tsc -p test && node --test \"test/**/*.test.js\"",
    "test:serial": "node test/run-serial.js",
    "test:coverage": "pnpm build && node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/**/*.test.js\"",
    "prepare": "pnpm build",
    "lint": "eslint ."
  },
  "keywords": [
    "modbus",
    "modbus-tcp",
    "modbus-rtu",
    "modbus-rtu-over-tcp",
    "modbus-udp",
    "modbus-rtu-over-udp",
    "modbus-client",
    "modbus-server",
    "serial",
    "rs485",
    "plc",
    "industrial-automation"
  ],
  "author": "goosy",
  "license": "ISC",
  "packageManager": "pnpm@12.15.0"
}
